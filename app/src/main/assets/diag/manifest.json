{
  "manifest_version": 2,
  "name": "TelikIVI diagnostics",
  "version": "1.2",
  "description": "Reports page script errors, failed requests and video state to the app's Menu screen.",
  "browser_specific_settings": { "gecko": { "id": "diag@telik.tv" } },
  "permissions": ["nativeMessaging", "nativeMessagingFromContent", "geckoViewAddons", "webRequest", "<all_urls>"],
  "web_accessible_resources": ["page.js"],
  "background": { "scripts": ["bg.js"] },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["cs.js"],
    "run_at": "document_start",
    "all_frames": true
  }]
}
